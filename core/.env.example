spring.ai.openai.base-url=https://api.openai-proxy.org
spring.ai.openai.api-key=<your-openai-api-key>
spring.ai.openai.chat.options.model=gpt-4o-mini
MCP_ENABLED=false
MCP_SERVER_URL=http://127.0.0.1:8082/mcp
MCP_TOOL_NAMES=createCopyDeck,createTestCase,createPpt,queryWeather
# Legacy aliases are still supported:
# OMLX_BASE_URL=https://api.openai-proxy.org
# OMLX_API_KEY=<your-openai-api-key>
# OMLX_MODEL=gpt-4o-mini
APP_HOST=0.0.0.0
APP_PORT=8000
CORS_ALLOW_ORIGINS=null
CORS_ALLOW_ORIGIN_REGEX=^https?://(localhost|127\.0\.0\.1)(:\d+)?$
CORS_ALLOW_CREDENTIALS=true
CORS_ALLOW_METHODS=*
CORS_ALLOW_HEADERS=*
